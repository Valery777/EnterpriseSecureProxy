{
  "ConnectionStrings": {
    "ProxyDb": "Host=localhost;Port=5432;Database=proxydb;Username=proxyuser;Password=ChangeMe",
    "SqlServerConnection": "Server=localhost;Database=SqlServerEnterpriseProxyDB;User Id=sa;Password=ChangeMe;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Encryption": {
    "Default": {
      "Key": "YOUR_BASE64_KEY"
    }
  },
  "CacheSettings": {
    "ConfigurationMinutes": {
      "value": 5
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "JwtSettings": {
    "Key": "JWT_KEY",
    "Issuer": "EnterpriseSecureProxy",
    "Audience": "EnterpriseSecureProxyUsers",
    "ExpiresInMinutes": 60
  },
  "AllowedHosts": "*"
}